{
  "name": "derek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @derek/core && npm run build -w @derek/worker && npm run build -w @derek/api",
    "heroku-postbuild": "npm run build -w @derek/core && npm run build -w @derek/worker && npm run build -w @derek/api",
    "start": "node packages/api/dist/server.js",
    "start:worker": "node packages/worker/dist/index.js",
    "admin": "node packages/worker/dist/admin.js",
    "test": "vitest run",
    "dev": "npm run build && node --env-file=.env packages/api/dist/server.js"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
