# Copy to .env for local dev. On Heroku these are config vars.
ANTHROPIC_API_KEY=
TOKEN_MINT_ADDRESS=
TREASURY_ADDRESS=
BURN_ADDRESS=
OPS_ADDRESS=
DEPOSIT_MASTER_SEED=          # 64 hex chars. KMS in production. Never in the repo.
RPC_URL=
DATABASE_URL=              # Heroku sets this; locally: postgres://derek:derek@localhost:55432/derek
FEE_TARGET_USD=0.40
MIN_LIQUIDITY_USD=15000
MAX_DAILY_API_USD=25
MAX_SUBMISSIONS_PER_HOUR=400
CLAIM_EXPIRY_DAYS=7
AUTO_APPROVE_UNFLAGGED=false  # keep false for the first ~100 rulings
PAUSED=true
X_API_KEY=
TOKEN_DECIMALS=9
CHAIN_ID=solana
FAKE_TREASURY_USD=            # pre-launch only: overrides on-chain treasury valuation
PORT=3000
